APP_NAME=Portfolio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Paris
APP_URL=http://localhost:8120

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=portfolio_db
DB_USERNAME=portfolio_user
DB_PASSWORD=portfolio_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="portfolio@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Délai maximal (secondes) de connexion au serveur SMTP
MAIL_TIMEOUT=5

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Adresse qui reçoit les messages du formulaire de contact
# (par défaut : l'e-mail de la présentation, sinon MAIL_FROM_ADDRESS)
CONTACT_RECIPIENT=

# Google reCAPTCHA v3 — https://www.google.com/recaptcha/admin
# Sans clés, la vérification est ignorée en local/test et refusée en production.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Bannissement des IP après 3 échecs de connexion en 15 min, pendant 45 min
LOGIN_BAN_ENABLED=true
LOGIN_BAN_MAX_ATTEMPTS=3
LOGIN_BAN_WINDOW=15
LOGIN_BAN_DURATION=45
# Adresses jamais bannies (IP ou plages CIDR séparées par des virgules)
LOGIN_BAN_WHITELIST=

# En-têtes de sécurité HTTP (CSP, HSTS…)
SECURITY_HEADERS=true

# Comptes « Personnel » : avertissement N jours avant la désactivation programmée (0 : jamais)
STAFF_DEACTIVATION_WARNING_DAYS=3

# Dépôts GitHub affichés sur les projets (facultatif : 60 → 5 000 requêtes/heure)
GITHUB_TOKEN=

VITE_APP_NAME="${APP_NAME}"

# --- Docker (docker-compose.yml / docker-compose.dev.yml) ---------------------
# Les conteneurs sont nommés d'après le dossier d'installation ; décommentez
# pour imposer un autre nom (utile pour plusieurs installations côte à côte).
# COMPOSE_PROJECT_NAME=portfolio

# Ports publiés sur la machine hôte (DB_FORWARD_PORT, PMA_PORT et MAILPIT_* :
# développement uniquement)
APP_PORT=8120
DB_FORWARD_PORT=3322
PMA_PORT=8121
MAILPIT_UI_PORT=8032
MAILPIT_SMTP_PORT=1032

# Mot de passe root du MariaDB de développement (appliqué uniquement à la
# création de la base). En production, la base est un serveur centralisé
# joignable via le réseau Docker externe « db_internal » : renseignez
# DB_HOST / DB_DATABASE / DB_USERNAME / DB_PASSWORD en conséquence.
DB_ROOT_PASSWORD=root_password

# Délai maximal (secondes) d'attente de la base au démarrage du conteneur
DB_WAIT_TIMEOUT=60

# Production : domaine routé par Traefik
APP_DOMAIN=app.example.com
