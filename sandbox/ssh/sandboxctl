#!/bin/bash
# Administration de la machine, appelée uniquement par sandbox-agent (clé root
# à commande forcée) : la sous-commande arrive dans SSH_ORIGINAL_COMMAND.
#
#   apply            JSON sur l'entrée : {"accounts":[{"username","hash","enabled"}],
#                    "limits":{"nproc","memory_kb","file_kb"}}
#   sessions         sessions ouvertes (JSON)
#   kill [user]      ferme les sessions d'un compte, ou de tous
#   usage            espace occupé par /home, en Ko
#   usage-users      espace occupé par compte, en Ko (JSON)
#   reap             tue les processus des comptes sans session ouverte
#   auth-log         journal d'authentification de sshd depuis la dernière lecture
#   managers         JSON sur l'entrée : {"managers":[{"username","keys":[…]}]} (comptes de gestion, UID 0)
#   upgrade          mise à jour des paquets (apk upgrade, par le proxy de sortie)
#   ephemeral-create crée un compte jetable (terminal web) ; renvoie {"username","password"}
#   ephemeral-delete <user>  supprime un compte jetable et son dossier
#   backup           archive tar.gz de /home sur la sortie
#   restore          remplace /home par l'archive lue sur l'entrée
set -euo pipefail

read -r -a ARGS <<< "${SSH_ORIGINAL_COMMAND:-${*:-}}"
COMMAND="${ARGS[0]:-}"
USERNAME_RE='^[a-z][a-z0-9_-]{2,31}$'
SANDBOX_GID="$(getent group sandbox | cut -d: -f3)"

# Comptes du bac à sable : groupe principal « sandbox »
sandbox_users() {
    awk -F: -v gid="$SANDBOX_GID" '$4 == gid { print $1 }' /etc/passwd
}

# UID réservés aux comptes (200000 et plus) : la limite de processus (ulimit -u)
# compte tous les processus de l'UID sur l'hôte, conteneurs compris ; un UID
# partagé avec l'hôte (1000…) serait épuisé par des processus étrangers.
UID_MIN=200000
next_uid() {
    awk -F: -v min="$UID_MIN" 'BEGIN { max = min - 1 } $3 >= min && $3 > max { max = $3 } END { print max + 1 }' /etc/passwd
}

ADMIN_GID="$(getent group sandboxadm | cut -d: -f3)"
MANAGER_RE='^adm-[a-z0-9_-]{2,27}$'

# Comptes de gestion : UID 0, groupe « sandboxadm »
manager_users() {
    awk -F: -v gid="$ADMIN_GID" '$4 == gid { print $1 }' /etc/passwd
}

# Ferme les sessions d'un compte de gestion. pkill -u viserait l'UID 0, donc tous les
# processus root (sshd compris) : on ne cible que les sessions sshd de ce compte.
kill_manager() {
    pkill -KILL -f "^sshd(-session)?: $1@" 2>/dev/null || true
}

# Comptes jetables du terminal web : marqués « ephemeral » (champ GECOS), jamais gérés par le panel
is_ephemeral() {
    [ "$(getent passwd "$1" | cut -d: -f5)" = "ephemeral" ]
}

delete_ephemeral() {
    is_ephemeral "$1" || return 0
    kill_user "$1"
    deluser "$1" >/dev/null 2>&1 || true
    rm -rf "/home/$1"
}

kill_user() {
    pkill -KILL -u "$1" 2>/dev/null || true
}

# Utilisateurs ayant une session SSH ouverte (« sshd-session: guest@pts/0 » ou « sshd: guest@notty »)
connected_users() {
    ps -eo args= | awk '$1 ~ /^sshd(-session)?:$/ && $2 ~ /@/ { split($2, a, "@"); print a[1] }' | sort -u
}

# Dossiers privés : propriétaire seul (0700). /home lui-même reste franchissable (0755) :
# une restauration applique à /home les droits de l'entrée « . » de l'archive (0700 pour
# une archive vide), ce qui interdirait l'accès à tous les comptes non root.
fix_owners() {
    chown root:root /home
    chmod 0755 /home
    # Dossier personnel manquant (réinitialisation, restauration) : recréé depuis /etc/skel
    for user in $(sandbox_users); do
        if [ ! -d "/home/$user" ]; then
            cp -a /etc/skel "/home/$user"
        fi
    done
    for dir in /home/*/; do
        [ -d "$dir" ] || continue
        user="$(basename "$dir")"
        if id "$user" >/dev/null 2>&1; then
            chown -R "$user:sandbox" "$dir"
            chmod 0700 "$dir"
        fi
    done
}

case "$COMMAND" in
    apply)
        desired="$(cat)"
        wanted="$(jq -r '.accounts[].username' <<< "$desired")"

        # Limites par compte, lues par /usr/local/sbin/session à chaque connexion
        jq -r '.limits // {} | "NPROC=\(.nproc // 24)\nMEMORY_KB=\(.memory_kb // 196608)\nFILE_KB=\(.file_kb // 102400)"' <<< "$desired" > /etc/sandbox/limits

        # Message d'accueil (panel) ; vide : message par défaut de l'image
        motd="$(jq -r '.motd // empty' <<< "$desired")"
        if [ -n "$motd" ]; then
            printf '\n%s\n\n' "$motd" > /etc/motd
        elif [ -f /etc/motd.default ]; then
            cp /etc/motd.default /etc/motd
        fi

        # Comptes retirés : sessions fermées, compte supprimé (dossier conservé jusqu'à restauration ou réinitialisation).
        for user in $(sandbox_users); do
            is_ephemeral "$user" && continue
            if ! grep -qx "$user" <<< "$wanted"; then
                kill_user "$user"
                deluser "$user" >/dev/null 2>&1 || true
            fi
        done

        jq -c '.accounts[]' <<< "$desired" | while read -r account; do
            user="$(jq -r '.username' <<< "$account")"
            hash="$(jq -r '.hash' <<< "$account")"
            enabled="$(jq -r '.enabled' <<< "$account")"
            [[ "$user" =~ $USERNAME_RE ]] || { echo "nom invalide : $user" >&2; continue; }
            [[ "$hash" == \$6\$* ]] || { echo "empreinte invalide pour $user" >&2; continue; }

            if ! id "$user" >/dev/null 2>&1; then
                adduser -D -u "$(next_uid)" -G sandbox -s /bin/bash -h "/home/$user" "$user" >/dev/null
            elif [ "$(id -g "$user")" != "$SANDBOX_GID" ]; then
                echo "compte système, ignoré : $user" >&2
                continue
            fi
            echo "$user:$hash" | chpasswd -e
            if [ "$enabled" = "true" ]; then
                usermod -U "$user" >/dev/null 2>&1 || true
            else
                usermod -L "$user" >/dev/null 2>&1 || true
                kill_user "$user"
            fi
        done
        fix_owners
        echo '{"ok":true}'
        ;;

    sessions)
        ps -eo pid=,etimes=,args= | awk '$3 ~ /^sshd(-session)?:$/ && $4 ~ /@/ && $4 !~ /^root@/ { split($4, a, "@"); printf "%s %s %s %s\n", $1, $2, a[1], a[2] }' \
            | jq -R -s -c 'split("\n") | map(select(length > 0) | split(" ") | {pid: (.[0]|tonumber), seconds: (.[1]|tonumber), username: .[2], tty: .[3], manager: (.[2] | startswith("adm-"))})'
        ;;

    kill)
        target="${ARGS[1]:-}"
        if [ -z "$target" ]; then
            for user in $(sandbox_users); do kill_user "$user"; done
        elif [[ "$target" =~ $MANAGER_RE ]]; then
            kill_manager "$target"
        elif [[ "$target" =~ $USERNAME_RE ]]; then
            kill_user "$target"
        fi
        echo '{"ok":true}'
        ;;

    usage)
        du -sk /home | cut -f1
        ;;

    usage-users)
        for dir in /home/*/; do
            [ -d "$dir" ] || continue
            printf '%s %s\n' "$(basename "$dir")" "$(du -sk "$dir" | cut -f1)"
        done | jq -R -s -c 'split("\n") | map(select(length > 0) | split(" ") | {(.[0]): (.[1]|tonumber)}) | add // {}'
        ;;

    auth-log)
        # Journal sshd depuis la dernière lecture (vidé ensuite)
        if [ -f /run/sshd-auth.log ]; then
            cat /run/sshd-auth.log
            : > /run/sshd-auth.log
        fi
        ;;

    reap)
        # Processus laissés après la déconnexion (nohup, &…) : supprimés.
        connected="$(connected_users)"
        for user in $(sandbox_users); do
            grep -qx "$user" <<< "$connected" && continue
            if is_ephemeral "$user"; then
                # Compte jetable sans session depuis plus de 2 minutes (création récente épargnée)
                if [ -z "$(find "/home/$user" -maxdepth 0 -mmin -2 2>/dev/null)" ]; then
                    delete_ephemeral "$user"
                    echo "$user"
                fi
            elif pgrep -u "$user" >/dev/null 2>&1; then
                kill_user "$user"
                echo "$user"
            fi
        done
        ;;

    managers)
        desired="$(cat)"
        wanted="$(jq -r '.managers[].username' <<< "$desired")"

        for user in $(manager_users); do
            if ! grep -qx "$user" <<< "$wanted"; then
                kill_manager "$user"
                sed -i "/^$user:/d" /etc/passwd /etc/shadow
                rm -f "/etc/sandbox/admin-keys/$user"
            fi
        done

        jq -c '.managers[]' <<< "$desired" | while read -r manager; do
            user="$(jq -r '.username' <<< "$manager")"
            [[ "$user" =~ $MANAGER_RE ]] || { echo "nom invalide : $user" >&2; continue; }
            if ! grep -q "^$user:" /etc/passwd; then
                # adduser refuse un UID déjà utilisé : ligne écrite directement. « * » : pas de
                # mot de passe, mais compte non verrouillé (sshd refuse les comptes « ! » même par clé).
                echo "$user:x:0:$ADMIN_GID:gestion:/root:/bin/bash" >> /etc/passwd
                echo "$user:*:$(( $(date +%s) / 86400 )):0:99999:7:::" >> /etc/shadow
            fi
            # Clés : une par ligne, sans options (les tunnels restent interdits globalement)
            jq -r '.keys[]' <<< "$manager" | grep -E '^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-nistp256@openssh\.com) [A-Za-z0-9+/=]+( .*)?$' \
                > "/etc/sandbox/admin-keys/$user.tmp" || true
            chmod 0644 "/etc/sandbox/admin-keys/$user.tmp"
            mv "/etc/sandbox/admin-keys/$user.tmp" "/etc/sandbox/admin-keys/$user"
        done
        echo '{"ok":true}'
        ;;

    upgrade)
        export http_proxy=http://sandbox-proxy:3128 https_proxy=http://sandbox-proxy:3128
        apk upgrade --no-cache 2>&1
        ;;

    ephemeral-create)
        user="tmp-$(od -An -N4 -tx1 /dev/urandom | tr -d ' \n')"
        password="$(od -An -N18 -tx1 /dev/urandom | tr -d ' \n')"
        adduser -D -u "$(next_uid)" -G sandbox -g ephemeral -s /bin/bash -h "/home/$user" "$user" >/dev/null
        echo "$user:$password" | chpasswd -c SHA512 >/dev/null
        chmod 0700 "/home/$user"
        jq -n -c --arg u "$user" --arg p "$password" '{username: $u, password: $p}'
        ;;

    ephemeral-delete)
        target="${ARGS[1]:-}"
        [[ "$target" =~ ^tmp-[a-z0-9]{8}$ ]] && delete_ephemeral "$target"
        echo '{"ok":true}'
        ;;

    ephemeral-purge)
        for user in $(sandbox_users); do delete_ephemeral "$user"; done
        echo '{"ok":true}'
        ;;

    backup)
        tar -czf - -C /home .
        ;;

    restore)
        for user in $(sandbox_users); do kill_user "$user"; done
        find /home -mindepth 1 -delete
        tar -xzf - -C /home --no-same-owner
        fix_owners
        echo '{"ok":true}'
        ;;

    *)
        echo "commande inconnue" >&2
        exit 2
        ;;
esac
