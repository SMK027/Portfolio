# Jeton partagé avec le portfolio (même valeur que SANDBOX_API_TOKEN dans le .env du portfolio) :
#   openssl rand -hex 32
SANDBOX_API_TOKEN=
# Domaine du portfolio : le terminal web est servi sur https://APP_DOMAIN/ssh-ws (Traefik)
APP_DOMAIN=app.example.com
# Port SSH public (ssh -p 2222 guest@domaine) : transmis au portfolio, qui l'affiche
SANDBOX_SSH_PUBLIC_PORT=2222
# Adresse affichée aux visiteurs (par défaut APP_DOMAIN)
SANDBOX_SSH_PUBLIC_HOST=
# Ressources de la machine
SANDBOX_CPUS=0.25
SANDBOX_MEMORY=128m
SANDBOX_PIDS=64
# Espace disque des dossiers personnels : au-delà, l'accès public est suspendu
SANDBOX_QUOTA_MB=512
# Limites de connexion
SANDBOX_MAX_SESSIONS=10
SANDBOX_MAX_SESSIONS_PER_IP=2
SANDBOX_MAX_CONNECTIONS_PER_MINUTE=10
# Quota disque strict (facultatif) : image ext4 créée par init-home-image.sh,
# utilisée avec docker-compose.quota.yml
SANDBOX_HOME_IMAGE=
# Sortie internet (quand elle est activée) : débit global en octets/s, connexions simultanées
SANDBOX_EGRESS_RATE=262144
SANDBOX_EGRESS_MAX_CONNECTIONS=20
